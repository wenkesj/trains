# Local training. Replace the key when using a hosted provider.
TINKER_API_KEY=tml-local
TINKER_TELEMETRY=0

# Hosted LangSmith. Fill in your key and workspace; adjust the endpoint for your region.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_PROJECT=existing-project
# Agent workspaces require all three: project (tracer_session_name), agent ID, environment.
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=

# For another training service, pass init-policy --training-url and --inference-url.
