# Local training. Replace the key when using a hosted provider.
TINKER_API_KEY=tml-local
TINKER_TELEMETRY=0

# Matches this example's local Langfuse Compose stack. Replace all three for hosted Langfuse.
LANGFUSE_BASE_URL=http://127.0.0.1:3031
LANGFUSE_PUBLIC_KEY=pk-lf-trains-local
LANGFUSE_SECRET_KEY=sk-lf-trains-local-development
# TRAINS_TRACE_PROJECT=existing-project
# For another training service, pass init-policy --training-url and --inference-url.

# Hosted alternative: TRAINS_TRACE_PROVIDER=langsmith
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
