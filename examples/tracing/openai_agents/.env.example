# Local training. Replace the key when using a hosted provider.
TINKER_API_KEY=tml-local
TINKER_TELEMETRY=0

PHOENIX_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_API_KEY=
# TRAINS_TRACE_PROJECT=existing-project
# For another training service, pass init-policy --training-url and --inference-url.

# Hosted alternative: TRAINS_TRACE_PROVIDER=arize-ax
# ARIZE_API_KEY=
# ARIZE_SPACE_ID=
# ARIZE_BACKEND=arize
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces
