# Source this file from examples/harvey_lab after initializing the data submodule.
LAB_ROOT="${PWD}/data"
BASETEN_API_KEY=local
BASETEN_BASE_URL=http://127.0.0.1:8382/v1
BASE_MODEL=LiquidAI/LFM3-Omni-2B
TOKENIZER_MODEL=LiquidAI/LFM3-Omni-2B
