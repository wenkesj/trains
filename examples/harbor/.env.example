# Local training. Replace the key when using a hosted provider.
TINKER_API_KEY=tml-local
TINKER_TELEMETRY=0
OPENAI_API_KEY="${TINKER_API_KEY}"
BASE_MODEL=LiquidAI/LFM3-Omni-2B
TOKENIZER_MODEL=LiquidAI/LFM3-Omni-2B
TRAINING_URL=http://127.0.0.1:8382
INFERENCE_URL=http://127.0.0.1:8382/oai/api/v1
# Hosted: replace URLs, key, model, and tokenizer together.
# Spindle: pass --provider spindle; inference needs a checkpoint-aware chat gateway.
