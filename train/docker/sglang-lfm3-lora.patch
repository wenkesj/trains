@@ -0,0 +1,28 @@
+"""LoRA geometry for LFM3 text and multimodal language decoders."""
+
+from sglang.srt.lora.utils import get_default_hidden_dim, get_stacked_multiply
+
+
+class Lfm3LoRAMixin:
+    supported_lora_modules = {
+        "qkv_proj", "o_proj", "out_proj", "in_proj", "gate_up_proj", "down_proj",
+        "self_attn.gate_proj",
+    }
+
+    def should_apply_lora(self, module_name):
+        return module_name.startswith(("model.layers.", "language_model.model.layers."))
+
+    def get_hidden_dim(self, module_name, layer_idx):
+        config = self.config.get_text_config()
+        hidden = config.hidden_size
+        if module_name == "in_proj":
+            return hidden, 3 * hidden
+        if module_name == "out_proj":
+            return hidden, hidden
+        if module_name == "self_attn.gate_proj":
+            return hidden, config.num_attention_heads
+        return get_default_hidden_dim(module_name, config, layer_idx)
+
+    def get_stacked_multiply(self, module_name):
+        # The native convolution packs three projections sharing the same HF A.
+        return 3 if module_name == "in_proj" else get_stacked_multiply(module_name)
