# Optional local model and native tracing provider services. Hosted providers use their own environment keys.
TRAIN_MODEL=LiquidAI/LFM3-Omni-2B
TRAIN_MODEL_PATH=./var/models/lfm3-omni
TRAIN_ROOT=/train
TRAIN_TRUST_REMOTE_CODE=true
TRAIN_GRADIENT_CHECKPOINTING=false
TRAIN_CHECKPOINT_OFFLOAD=false
TRAIN_MLP_CHUNK_SIZE=2048
TRAIN_ATTENTION_BACKEND=auto
INFERENCE_CONTEXT_LENGTH=32768
INFERENCE_MEMORY_FRACTION=0.4
TRAINS_TRAINING_URL=http://127.0.0.1:8382
TRAINS_INFERENCE_URL=http://127.0.0.1:8382/v1
# Host training server settings; Compose configures its internal service URL.
TRAIN_INFERENCE_BACKEND=sglang
TRAIN_INFERENCE_CHECKPOINT_MODE=merged
TRAIN_INFERENCE_MODEL_PATH=/models
TRAIN_INFERENCE_URL=http://127.0.0.1:30000
TRAIN_INFERENCE_TRAIN_ROOT=/train
TRAIN_INFERENCE_BASE_MODEL=LiquidAI/LFM3-Omni-2B
TRAIN_INFERENCE_SHARED_GPU=true
# Optional serving output ceiling; does not truncate prompts.
TRAIN_INFERENCE_MAX_OUTPUT_TOKENS=4096
# TINKER_API_KEY=...
# PHOENIX_API_KEY=...

PHOENIX_BASE_URL=http://127.0.0.1:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006

# Hosted tracing; source these with `uv run --env-file /path/to/trains/.env ...`.
# ARIZE_API_KEY=...
# ARIZE_SPACE_ID=...
# ARIZE_BACKEND=arize
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces
# LANGSMITH_API_KEY=...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=...
# Projects are generated per run; LANGSMITH_PROJECT optionally selects an existing one.
